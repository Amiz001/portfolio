---
import { siteMeta } from '../data/portfolio';
---

<section id="contact" class="relative w-full py-16 sm:py-24 px-4 sm:px-8 md:px-12 lg:px-16 overflow-hidden bg-[#04070d]">
  <!-- Glow effects -->
  <div class="absolute bottom-10 left-10 w-96 h-96 rounded-full glow-ambient blur-[150px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-96 h-96 rounded-full bg-[#2563eb]/8 blur-[150px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto w-full">
    <!-- Header -->
    <div class="pb-10 sm:pb-16 border-b border-white/10">
      <span class="text-xs font-mono text-[#60a5fa] uppercase tracking-wider block mb-2">
        04 / Contact
      </span>
      <h2 class="text-[clamp(1.85rem,6.2vw,4.5rem)] font-black font-['Syne',sans-serif] tracking-tight text-white leading-[1.04] break-words">
        LET'S MAKE YOUR NEXT
        <span class="block text-gradient">BIG IDEA REAL.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 pt-10 sm:pt-16">
      <!-- Left Column: Contact Coordinates & Direct Links -->
      <div class="lg:col-span-5 flex flex-col justify-start gap-6 sm:gap-8">
        <p class="text-base sm:text-lg text-[#8e9fb5] leading-relaxed">
          Have a project in mind, an engineering role, or want to collaborate? Send a message or get in touch directly through any channel below.
        </p>

        <!-- Direct Channels & Networks Grouped Cleanly -->
        <div class="flex flex-col gap-5 pt-1">
          <!-- Direct Email with Official Gmail SVG Icon -->
          <a
            href={`mailto:${siteMeta.email}`}
            data-magnetic
            class="flex items-center gap-4 p-4 rounded-xl bg-[#0a1220] border border-[#60a5fa]/25 hover:border-[#60a5fa] text-white transition-all group shadow-sm hover:shadow-[0_0_20px_rgba(96,165,250,0.2)]"
          >
            <div class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <!-- Official 4-color Google Mail Mark -->
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M1.5 20.5h4v-10l-4-3v11.5c0 .83.67 1.5 1.5 1.5z"/>
                <path fill="#34A853" d="M18.5 20.5h4c.83 0 1.5-.67 1.5-1.5V7.5l-4 3v10z"/>
                <path fill="#EA4335" d="M18.5 4.5l-6.5 4.88-6.5-4.88c-1.35-1.01-3.25-.05-3.25 1.65v1.35l9.75 7.31 9.75-7.31V6.15c0-1.7-1.9-2.66-3.25-1.65z"/>
                <path fill="#FBBC05" d="M5.5 10.5v-3L1.5 4.5v3l4 3z"/>
                <path fill="#C5221F" d="M18.5 10.5v-3l4-3v3l-4 3z"/>
              </svg>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-[10px] text-[#8e9fb5] uppercase tracking-wider font-mono">Direct Email</span>
              <span class="font-bold font-mono text-sm sm:text-base group-hover:text-[#60a5fa] transition-colors truncate">{siteMeta.email}</span>
            </div>
            <span class="ml-auto text-xs text-[#60a5fa] font-mono group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </a>

          <!-- Social Profiles -->
          <div>
            <span class="text-xs font-mono text-[#94a3b8] uppercase tracking-widest block mb-3 font-medium">
              Socials & Professional Networks
            </span>
            <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 gap-2.5">
              <!-- GitHub -->
              <a
                href={siteMeta.socials.github}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#0c1628] border border-[#60a5fa]/20 hover:border-[#60a5fa] text-xs font-mono text-[#cbd5e1] hover:text-white transition-all group shadow-sm hover:shadow-[0_0_18px_rgba(96,165,250,0.2)]"
              >
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 fill-current text-[#60a5fa] group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  <span class="font-medium">GitHub</span>
                </div>
                <span class="text-[10px] text-[#60a5fa] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>

              <!-- LinkedIn -->
              <a
                href={siteMeta.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#0c1628] border border-[#60a5fa]/20 hover:border-[#60a5fa] text-xs font-mono text-[#cbd5e1] hover:text-white transition-all group shadow-sm hover:shadow-[0_0_18px_rgba(96,165,250,0.2)]"
              >
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 fill-current text-[#60a5fa] group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  <span class="font-medium">LinkedIn</span>
                </div>
                <span class="text-[10px] text-[#60a5fa] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>

              <!-- HackerRank -->
              <a
                href={siteMeta.socials.hackerrank}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#0c1628] border border-[#60a5fa]/20 hover:border-[#60a5fa] text-xs font-mono text-[#cbd5e1] hover:text-white transition-all group shadow-sm hover:shadow-[0_0_18px_rgba(96,165,250,0.2)]"
              >
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 fill-current text-[#22c55e] group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                    <path d="M12 0L1.608 6v12L12 24l10.392-6V6L12 0zm3.84 14.88h-1.68v-2.28H9.84v2.28H8.16V9.12h1.68v2.16h4.32V9.12h1.68v5.76z"/>
                  </svg>
                  <span class="font-medium">HackerRank</span>
                </div>
                <span class="text-[10px] text-[#60a5fa] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>

              <!-- Instagram -->
              <a
                href={siteMeta.socials.instagram}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#0c1628] border border-[#60a5fa]/20 hover:border-[#60a5fa] text-xs font-mono text-[#cbd5e1] hover:text-white transition-all group shadow-sm hover:shadow-[0_0_18px_rgba(96,165,250,0.2)]"
              >
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 fill-current text-[#ec4899] group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                  <span class="font-medium">Instagram</span>
                </div>
                <span class="text-[10px] text-[#60a5fa] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Elevated Glass Architectural Contact Form -->
      <div class="lg:col-span-7 bg-[#0a1220]/95 border border-[#60a5fa]/25 rounded-2xl p-6 sm:p-10 shadow-2xl relative overflow-hidden backdrop-blur-xl">
        <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-br from-[#2563eb]/20 to-[#60a5fa]/10 blur-3xl pointer-events-none"></div>

        <form id="contact-form" class="flex flex-col gap-5 sm:gap-6 relative z-10">
          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="name" class="text-xs font-mono font-medium text-[#dbeafe] uppercase tracking-wider flex items-center justify-between">
              <span>Your Name</span>
              <span class="text-[#60a5fa] text-[10px] tracking-normal font-mono">REQUIRED</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Morgan"
              class="w-full px-4 py-3.5 rounded-xl bg-[#0c1628]/95 border border-[#60a5fa]/30 text-white placeholder-[#94a3b8]/70 focus:outline-none focus:border-[#60a5fa] focus:ring-1 focus:ring-[#60a5fa]/40 shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)] transition-all font-sans text-sm sm:text-base"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs font-mono font-medium text-[#dbeafe] uppercase tracking-wider flex items-center justify-between">
              <span>Your Email Address</span>
              <span class="text-[#60a5fa] text-[10px] tracking-normal font-mono">REQUIRED</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="e.g. alex@company.com"
              class="w-full px-4 py-3.5 rounded-xl bg-[#0c1628]/95 border border-[#60a5fa]/30 text-white placeholder-[#94a3b8]/70 focus:outline-none focus:border-[#60a5fa] focus:ring-1 focus:ring-[#60a5fa]/40 shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)] transition-all font-sans text-sm sm:text-base"
            />
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs font-mono font-medium text-[#dbeafe] uppercase tracking-wider flex items-center justify-between">
              <span>Project Brief or Message</span>
              <span class="text-[#60a5fa] text-[10px] tracking-normal font-mono">REQUIRED</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell me about your project, timeline, or engineering role..."
              class="w-full px-4 py-3.5 rounded-xl bg-[#0c1628]/95 border border-[#60a5fa]/30 text-white placeholder-[#94a3b8]/70 focus:outline-none focus:border-[#60a5fa] focus:ring-1 focus:ring-[#60a5fa]/40 shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)] transition-all font-sans text-sm sm:text-base resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            data-magnetic
            class="mt-2 w-full py-4 rounded-xl font-bold text-sm tracking-wider bg-gradient-to-r from-[#3b82f6] via-[#60a5fa] to-[#bae6fd] text-black hover:opacity-95 transition-all shadow-[0_0_25px_rgba(96,165,250,0.25)] hover:shadow-[0_0_35px_rgba(96,165,250,0.4)] flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed font-mono"
          >
            <span id="btn-text">SEND MESSAGE</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Status Message -->
          <div id="form-status" class="hidden text-center text-xs font-mono py-2 rounded-lg"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { siteMeta } from '../data/portfolio';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const statusDiv = document.getElementById('form-status');

  if (form && submitBtn && btnText && statusDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const message = formData.get('message') as string;

      if (!name || !email || !message) return;

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'SENDING...';
      statusDiv.classList.add('hidden');

      try {
        // Direct EmailJS API call using user's existing credentials
        const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            service_id: siteMeta.emailJs.serviceId,
            template_id: siteMeta.emailJs.templateId,
            user_id: siteMeta.emailJs.publicKey,
            template_params: {
              name,
              email,
              message,
              time: new Date().toLocaleString(),
            },
          }),
        });

        if (response.ok) {
          form.reset();
          btnText.textContent = 'MESSAGE SENT ✓';
          statusDiv.textContent = 'Thank you! Your message has been received. I will reply shortly.';
          statusDiv.className = 'text-center text-xs font-mono py-2.5 rounded-lg bg-[#60a5fa]/10 text-[#60a5fa] border border-[#60a5fa]/30 block';
        } else {
          throw new Error('Transmission failed');
        }
      } catch (err) {
        console.error(err);
        btnText.textContent = 'FAILED TO SEND ✕';
        statusDiv.textContent = 'Unable to send message via form. Please email directly at lgmalshan@gmail.com';
        statusDiv.className = 'text-center text-xs font-mono py-2.5 rounded-lg bg-red-500/10 text-red-400 border border-red-500/30 block';
      } finally {
        submitBtn.disabled = false;
        setTimeout(() => {
          btnText.textContent = 'SEND MESSAGE';
        }, 4000);
      }
    });
  }
</script>
