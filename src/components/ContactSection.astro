---
import { siteMeta } from '../data/portfolio';
---

<section id="contact" class="relative w-full py-24 sm:py-32 px-4 sm:px-8 md:px-12 lg:px-16 overflow-hidden bg-[#060806]">
  <!-- Glow effects -->
  <div class="absolute bottom-10 left-10 w-96 h-96 rounded-full glow-ambient blur-[150px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-96 h-96 rounded-full bg-[#ffd600]/5 blur-[150px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto w-full">
    <!-- Header -->
    <div class="pb-12 sm:pb-16 border-b border-white/10">
      <span class="text-xs font-mono text-[#b8ff01] uppercase tracking-wider block mb-2">
        04 / Contact
      </span>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-black font-['Syne',sans-serif] tracking-tight text-white">
        LET'S MAKE YOUR NEXT
        <span class="block text-gradient">BIG IDEA REAL.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pt-12 sm:pt-16">
      <!-- Left Column: Contact Coordinates & Direct Links -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-10">
        <div class="flex flex-col gap-6">
          <p class="text-base sm:text-lg text-[#9aa196] leading-relaxed">
            Have a project in mind, an engineering role, or want to collaborate? Send a message or get in touch directly through any channel below.
          </p>

          <!-- Direct Coordinates -->
          <div class="flex flex-col gap-4 pt-4 font-mono text-sm">
            <!-- Email -->
            <a
              href={`mailto:${siteMeta.email}`}
              data-magnetic
              class="flex items-center gap-4 p-4 rounded-xl bg-[#0e140e] border border-white/10 hover:border-[#b8ff01]/40 text-white transition-all group"
            >
              <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-[#b8ff01]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-[#9aa196] uppercase tracking-wider">Direct Email</span>
                <span class="font-bold group-hover:text-[#b8ff01] transition-colors">{siteMeta.email}</span>
              </div>
            </a>

            <!-- Phone -->
            <a
              href={`tel:${siteMeta.phone}`}
              data-magnetic
              class="flex items-center gap-4 p-4 rounded-xl bg-[#0e140e] border border-white/10 hover:border-[#b8ff01]/40 text-white transition-all group"
            >
              <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-[#10f587]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-[#9aa196] uppercase tracking-wider">Phone</span>
                <span class="font-bold group-hover:text-[#10f587] transition-colors">{siteMeta.displayPhone}</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Social Profiles -->
        <div>
          <span class="text-xs font-mono text-[#9aa196] uppercase tracking-widest block mb-3">
            Socials & Profiles
          </span>
          <div class="flex flex-wrap gap-3">
            <a
              href={siteMeta.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="px-4 py-2.5 rounded-lg bg-[#0e140e] border border-white/10 text-xs font-mono text-white hover:border-[#b8ff01] hover:text-[#b8ff01] transition-all"
            >
              GitHub ↗
            </a>
            <a
              href={siteMeta.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="px-4 py-2.5 rounded-lg bg-[#0e140e] border border-white/10 text-xs font-mono text-white hover:border-[#b8ff01] hover:text-[#b8ff01] transition-all"
            >
              LinkedIn ↗
            </a>
            <a
              href={siteMeta.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="px-4 py-2.5 rounded-lg bg-[#0e140e] border border-white/10 text-xs font-mono text-white hover:border-[#b8ff01] hover:text-[#b8ff01] transition-all"
            >
              Instagram ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Minimalist Architectural Contact Form -->
      <div class="lg:col-span-7 bg-[#0e140e] border border-white/10 rounded-2xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#10f587]/10 to-[#ffd600]/10 blur-2xl pointer-events-none"></div>

        <form id="contact-form" class="flex flex-col gap-6 relative z-10">
          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="name" class="text-xs font-mono text-[#8e9688] uppercase tracking-wider">
              YOUR NAME *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Elena Rostova"
              class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white placeholder-white/20 focus:outline-none focus:border-[#b8ff01] transition-colors font-mono text-sm"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs font-mono text-[#8e9688] uppercase tracking-wider">
              YOUR EMAIL ADDRESS *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="e.g. elena@company.com"
              class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white placeholder-white/20 focus:outline-none focus:border-[#b8ff01] transition-colors font-mono text-sm"
            />
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs font-mono text-[#8e9688] uppercase tracking-wider">
              PROJECT BRIEF OR MESSAGE *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell me about your project, timelines, or role..."
              class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white placeholder-white/20 focus:outline-none focus:border-[#b8ff01] transition-colors font-mono text-sm resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            data-magnetic
            class="mt-2 w-full py-4 rounded-xl font-bold text-sm tracking-wider bg-gradient-to-r from-[#10f587] via-[#b8ff01] to-[#ffd600] text-black hover:opacity-95 transition-all shadow-[0_0_25px_rgba(184,255,1,0.25)] hover:shadow-[0_0_35px_rgba(184,255,1,0.4)] flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text">SEND MESSAGE</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Status Message -->
          <div id="form-status" class="hidden text-center text-xs font-mono py-2 rounded-lg"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { siteMeta } from '../data/portfolio';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const statusDiv = document.getElementById('form-status');

  if (form && submitBtn && btnText && statusDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const message = formData.get('message') as string;

      if (!name || !email || !message) return;

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'SENDING...';
      statusDiv.classList.add('hidden');

      try {
        // Direct EmailJS API call using user's existing credentials
        const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            service_id: siteMeta.emailJs.serviceId,
            template_id: siteMeta.emailJs.templateId,
            user_id: siteMeta.emailJs.publicKey,
            template_params: {
              name,
              email,
              message,
              time: new Date().toLocaleString(),
            },
          }),
        });

        if (response.ok) {
          form.reset();
          btnText.textContent = 'MESSAGE SENT ✓';
          statusDiv.textContent = 'Thank you! Your message has been received. I will reply shortly.';
          statusDiv.className = 'text-center text-xs font-mono py-2.5 rounded-lg bg-[#10f587]/10 text-[#10f587] border border-[#10f587]/30 block';
        } else {
          throw new Error('Transmission failed');
        }
      } catch (err) {
        console.error(err);
        btnText.textContent = 'FAILED TO SEND ✕';
        statusDiv.textContent = 'Unable to send message via form. Please email directly at lgmalshan@gmail.com';
        statusDiv.className = 'text-center text-xs font-mono py-2.5 rounded-lg bg-red-500/10 text-red-400 border border-red-500/30 block';
      } finally {
        submitBtn.disabled = false;
        setTimeout(() => {
          btnText.textContent = 'SEND MESSAGE';
        }, 4000);
      }
    });
  }
</script>

