---
import { projects } from '../data/portfolio';

const featuredProjects = projects.filter((p) => p.featured);
const archiveProjects = projects;
---

<section id="work" class="relative w-full py-24 sm:py-32 px-4 sm:px-8 md:px-12 lg:px-16 overflow-hidden">
  <!-- Subtle ambient background glow -->
  <div class="absolute top-1/3 left-0 w-[400px] h-[400px] rounded-full bg-[#10f587]/5 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-0 w-[400px] h-[400px] rounded-full bg-[#ffd600]/5 blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto w-full">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12 sm:pb-16 border-b border-white/10">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#b8ff01] uppercase tracking-wider mb-3">
          <span>01 / Selected Work</span>
          <span class="text-white/40">•</span>
          <span class="text-white/80">{projects.length} Shipped Projects</span>
        </div>
        <h2 class="text-4xl sm:text-6xl md:text-7xl font-black font-['Syne',sans-serif] tracking-tight text-white">
          SELECTED
          <span class="text-gradient">WORK.</span>
        </h2>
      </div>

      <p class="text-sm sm:text-base text-[#9aa196] max-w-md font-normal leading-relaxed">
        A curated selection of full-stack web platforms, AI applications, and award-winning user interfaces built with performance at their core.
      </p>
    </div>

    <!-- TIER 1: Featured Parallax Project Case Studies -->
    <div class="flex flex-col gap-24 sm:gap-36 lg:gap-44 pt-16 sm:pt-24">
      {featuredProjects.map((project, idx) => {
        const isEven = idx % 2 === 1;
        const projectIndexStr = String(idx + 1).padStart(2, '0');

        return (
          <article class="project-case-study grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
            <!-- Project Image Frame (Left on even, Right on odd) -->
            <div class={`lg:col-span-7 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
              <a
                href={project.demoUrl || project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor="view"
                class="group block relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-[#0d120d] border border-white/10 hover:border-[#b8ff01]/40 transition-colors duration-500 shadow-[0_20px_50px_rgba(0,0,0,0.6)] hover:shadow-[0_20px_50px_rgba(184,255,1,0.15)]"
              >
                <!-- Outer Wrap: GSAP Parallax Target (no CSS transitions here) -->
                <div class="image-parallax-wrap w-full h-[120%] -top-[10%] relative overflow-hidden will-change-transform">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top filter brightness-[0.9] contrast-[1.05] group-hover:brightness-100 group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="lazy"
                  />
                </div>

                <!-- Hover Gradient Aura -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-300 pointer-events-none"></div>

                <!-- Bottom Floating Chip on Hover -->
                <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 px-4 py-2 rounded-lg bg-black/80 border border-white/20 backdrop-blur-md text-xs font-mono text-white flex items-center gap-2 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                  <span class="text-[#b8ff01]">EXPLORE CASE</span>
                  <span>↗</span>
                </div>
              </a>
            </div>

            <!-- Project Details Column (Right on even, Left on odd) -->
            <div class={`lg:col-span-5 flex flex-col items-start gap-5 sm:gap-6 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
              <!-- Index & Category -->
              <div class="flex items-center gap-3 text-xs font-mono text-[#9aa196]">
                <span class="text-xl sm:text-2xl font-bold text-[#b8ff01] font-['Syne',sans-serif]">
                  {projectIndexStr}
                </span>
                <span class="text-white/20">/</span>
                <span class="uppercase tracking-wider">{project.category}</span>
                <span class="text-white/20">•</span>
                <span>{project.year}</span>
              </div>

              <!-- Title & Subtitle -->
              <div>
                <h3 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white font-['Syne',sans-serif] group">
                  {project.title}
                </h3>
                <p class="text-sm sm:text-base text-[#b8ff01] font-mono mt-1">
                  {project.subtitle}
                </p>
              </div>

              <!-- Award Callout if applicable (e.g. Suva Saviya) -->
              {project.award && (
                <div class="w-full px-4 py-2.5 rounded-lg bg-[#b8ff01]/10 border border-[#b8ff01]/30 text-xs font-mono text-[#b8ff01] flex items-center gap-2">
                  <span>{project.award}</span>
                </div>
              )}

              <!-- Description -->
              <p class="text-sm sm:text-base text-[#9aa196] leading-relaxed font-normal">
                {project.description}
              </p>

              <!-- Technical Spec Grid -->
              <div class="w-full pt-4 border-t border-white/10">
                <span class="text-[11px] font-mono text-white/50 uppercase tracking-widest block mb-2.5">
                  CORE ARCHITECTURE & STACK
                </span>
                <div class="flex flex-wrap gap-2">
                  {project.stack.map((tech) => (
                    <span class="px-2.5 py-1 rounded bg-[#0e140e] border border-white/10 text-xs font-mono text-[#f4f6f0]/90">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Links -->
              <div class="flex items-center gap-4 pt-2">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-magnetic
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-bold tracking-wide bg-gradient-to-r from-[#10f587] to-[#b8ff01] text-black hover:opacity-90 transition-all shadow-[0_0_20px_rgba(184,255,1,0.2)]"
                  >
                    <span>LIVE DEMO</span>
                    <span>↗</span>
                  </a>
                )}

                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-magnetic
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold tracking-wide bg-[#0e140e] hover:bg-[#151f15] text-white border border-white/10 hover:border-[#b8ff01]/40 transition-all"
                >
                  <span>SOURCE CODE</span>
                  <span class="text-xs text-[#9aa196]">↗</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- TIER 2: Scalable Interactive Archive Ledger -->
    <div class="mt-32 sm:mt-44 pt-16 border-t border-white/10 relative">
      <!-- Floating Project Image Preview (Desktop) -->
      <div
        id="archive-preview"
        class="fixed pointer-events-none z-50 w-72 h-44 rounded-xl overflow-hidden border border-white/20 shadow-[0_25px_60px_rgba(0,0,0,0.8)] opacity-0 scale-95 transition-[opacity,transform] duration-300 hidden md:block bg-[#0e140e]"
      >
        <img id="archive-preview-img" src="/images/parkbay.webp" alt="Preview" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div id="archive-preview-title" class="absolute bottom-2.5 left-3 text-xs font-mono font-bold text-white drop-shadow">
          ParkBay
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-xs font-mono text-[#b8ff01] uppercase tracking-wider block mb-1">
            Complete Index
          </span>
          <h3 class="text-2xl sm:text-4xl font-extrabold text-white font-['Syne',sans-serif]">
            PROJECT ARCHIVE & EXPERIMENTS
          </h3>
        </div>
        <span class="text-xs font-mono text-[#9aa196]">
          Showing all {archiveProjects.length} repositories
        </span>
      </div>

      <!-- Ledger Table -->
      <div class="w-full overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[650px]">
          <thead>
            <tr class="border-b border-white/10 text-xs font-mono text-[#9aa196] uppercase tracking-wider">
              <th class="py-3 px-4 font-normal">YEAR</th>
              <th class="py-3 px-4 font-normal">PROJECT</th>
              <th class="py-3 px-4 font-normal">CATEGORY</th>
              <th class="py-3 px-4 font-normal">STACK</th>
              <th class="py-3 px-4 font-normal text-right">LINK</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-mono text-sm">
            {archiveProjects.map((p) => (
              <tr
                class="archive-row group hover:bg-[#0e140e] transition-colors duration-200 cursor-pointer"
                data-image={p.image}
                data-title={p.title}
              >
                <td class="py-4 px-4 text-[#9aa196] text-xs">{p.year}</td>
                <td class="py-4 px-4 font-bold text-white group-hover:text-[#b8ff01] transition-colors">
                  <a href={p.demoUrl || p.githubUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
                    <span>{p.title}</span>
                    {p.award && <span class="text-[10px] text-[#ffd600]">★</span>}
                  </a>
                </td>
                <td class="py-4 px-4 text-[#9aa196] text-xs">{p.category}</td>
                <td class="py-4 px-4 text-xs text-white/70">
                  {p.stack.slice(0, 3).join(', ')}
                </td>
                <td class="py-4 px-4 text-right">
                  <a
                    href={p.demoUrl || p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-magnetic
                    class="inline-flex items-center gap-1 text-xs text-[#9aa196] group-hover:text-[#b8ff01] transition-colors"
                  >
                    <span>VIEW</span>
                    <span>↗</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Parallax scrubbing on outer wrap container (no CSS transition conflict)
  document.querySelectorAll('.project-case-study').forEach((study) => {
    const wrap = study.querySelector('.image-parallax-wrap');
    if (wrap) {
      gsap.fromTo(
        wrap,
        { yPercent: -7 },
        {
          yPercent: 7,
          ease: 'none',
          scrollTrigger: {
            trigger: study,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        }
      );
    }
  });

  // Archive interactive cursor-tracking image preview
  const preview = document.getElementById('archive-preview');
  const previewImg = document.getElementById('archive-preview-img') as HTMLImageElement | null;
  const previewTitle = document.getElementById('archive-preview-title');

  if (preview && previewImg && previewTitle) {
    const xTo = gsap.quickTo(preview, 'x', { duration: 0.25, ease: 'power2.out' });
    const yTo = gsap.quickTo(preview, 'y', { duration: 0.25, ease: 'power2.out' });

    window.addEventListener('mousemove', (e) => {
      // Offset preview slightly so it hovers near cursor without blocking clicks
      xTo(e.clientX + 20);
      yTo(e.clientY - 90);
    });

    document.querySelectorAll('.archive-row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        const img = (row as HTMLElement).dataset.image;
        const title = (row as HTMLElement).dataset.title;
        if (img && previewImg) {
          previewImg.src = img;
        }
        if (title && previewTitle) {
          previewTitle.textContent = title;
        }
        preview.classList.remove('opacity-0', 'scale-95');
        preview.classList.add('opacity-100', 'scale-100');
      });

      row.addEventListener('mouseleave', () => {
        preview.classList.remove('opacity-100', 'scale-100');
        preview.classList.add('opacity-0', 'scale-95');
      });
    });
  }
</script>

