---
import { siteMeta } from "../data/portfolio";
---

<header
  class="fixed top-0 left-0 w-full z-50 pointer-events-none transition-all duration-300 px-4 sm:px-8 md:px-12 py-4 md:py-6"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-between pointer-events-auto"
  >
    <!-- Brand / Monogram -->
    <a
      href="#"
      class="flex items-center gap-3 group focus:outline-none"
      aria-label="Home"
    >
      <!-- <div
        class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-[#0e140e] border border-white/10 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-[#b8ff01]/40 group-hover:shadow-[0_0_20px_rgba(184,255,1,0.2)]"
      >
        <img
          src="/images/LOGO.webp"
          alt="Amiz Monogram"
          class="w-5 h-5 sm:w-6 sm:h-6 object-contain filter invert opacity-90 transition-transform duration-300 group-hover:scale-110"
        />
      </div> -->
      <div class="flex flex-col">
        <span
          class="text-sm sm:text-base font-bold tracking-tight text-white group-hover:text-[#b8ff01] transition-colors font-['Syne',sans-serif]"
        >
          {siteMeta.handle.toUpperCase()}
        </span>
        <!-- <span class="text-[11px] tracking-wide text-[#9aa196] font-mono -mt-0.5">
          Software Developer
        </span> -->
      </div>
    </a>

    <!-- Center Studio Meta & Availability (Desktop) -->
    <!-- <div class="hidden lg:flex items-center gap-3 text-xs text-[#9aa196]">
      <span class="inline-flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10f587] opacity-60"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10f587]"
          ></span>
        </span>
        <span class="text-white/90 font-medium">Colombo, LK</span>
      </span>
      <span class="text-white/20">—</span>
      <span id="colombo-clock" class="font-mono text-white/70"
        >01:06 UTC+5:30</span
      >
      <span class="text-white/20">—</span>
      <span
        class="text-[#b8ff01] font-mono text-[11px] tracking-wider uppercase"
        >Available for work</span
      >
    </div> -->

    <!-- Desktop Navigation Links -->
    <nav
      class="hidden md:flex items-center gap-7 bg-[#0e140e]/80 border border-white/10 backdrop-blur-md rounded-full px-6 py-2 shadow-sm"
    >
      <a
        href="#work"
        class="text-xs uppercase tracking-wider text-[#9aa196] hover:text-white transition-colors duration-200"
      >
        Work
      </a>
      <a
        href="#capabilities"
        class="text-xs uppercase tracking-wider text-[#9aa196] hover:text-white transition-colors duration-200"
      >
        Craft
      </a>
      <a
        href="#about"
        class="text-xs uppercase tracking-wider text-[#9aa196] hover:text-white transition-colors duration-200"
      >
        About
      </a>
      <a
        href="#contact"
        class="text-xs uppercase tracking-wider text-[#9aa196] hover:text-white transition-colors duration-200"
      >
        Contact
      </a>
    </nav>

    <!-- Right Action / Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href="#contact"
        data-magnetic
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-full text-xs font-semibold tracking-wide bg-gradient-to-r from-[#10f587] via-[#b8ff01] to-[#ffd600] text-black hover:opacity-90 transition-all duration-300 shadow-[0_0_20px_rgba(184,255,1,0.25)] hover:shadow-[0_0_25px_rgba(184,255,1,0.45)] hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>LET'S TALK</span>
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            d="M7 17L17 7M17 7H7M17 7V17"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-10 h-10 rounded-lg bg-[#0e140e] border border-white/10 flex flex-col items-center justify-center gap-1.5 text-white focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <span
          class="w-5 h-[1.5px] bg-white transition-transform duration-300"
          id="burger-line-1"></span>
        <span
          class="w-5 h-[1.5px] bg-[#b8ff01] transition-transform duration-300"
          id="burger-line-2"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-drawer"
    class="md:hidden fixed inset-x-4 top-20 bg-[#0a0e0a]/95 border border-white/10 backdrop-blur-xl rounded-2xl p-6 pointer-events-auto transition-all duration-300 opacity-0 translate-y-[-10px] pointer-events-none"
  >
    <div class="flex flex-col gap-4">
      <div
        class="flex items-center justify-between pb-3 border-b border-white/10 text-xs font-mono text-[#9aa196]"
      >
        <span>STATUS</span>
        <span class="text-[#10f587] flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-[#10f587]"></span>
          Available in Colombo, LK
        </span>
      </div>
      <a
        href="#work"
        class="mobile-nav-link text-lg font-bold text-white hover:text-[#b8ff01] flex items-center justify-between py-2 border-b border-white/5"
      >
        <span>01. Selected Work</span>
        <span class="text-xs font-mono text-[#9aa196]">↗</span>
      </a>
      <a
        href="#capabilities"
        class="mobile-nav-link text-lg font-bold text-white hover:text-[#b8ff01] flex items-center justify-between py-2 border-b border-white/5"
      >
        <span>02. Capabilities & Stack</span>
        <span class="text-xs font-mono text-[#9aa196]">↗</span>
      </a>
      <a
        href="#about"
        class="mobile-nav-link text-lg font-bold text-white hover:text-[#b8ff01] flex items-center justify-between py-2 border-b border-white/5"
      >
        <span>03. About & Experience</span>
        <span class="text-xs font-mono text-[#9aa196]">↗</span>
      </a>
      <a
        href="#contact"
        class="mobile-nav-link text-lg font-bold text-white hover:text-[#b8ff01] flex items-center justify-between py-2"
      >
        <span>04. Contact</span>
        <span class="text-xs font-mono text-[#9aa196]">↗</span>
      </a>
      <a
        href="#contact"
        class="mobile-nav-link mt-2 w-full py-3 rounded-xl text-center font-bold text-sm bg-gradient-to-r from-[#10f587] via-[#b8ff01] to-[#ffd600] text-black"
      >
        START A PROJECT
      </a>
    </div>
  </div>
</header>

<script>
  // Colombo Live Clock
  const updateColomboClock = () => {
    const el = document.getElementById("colombo-clock");
    if (!el) return;
    const now = new Date();
    // Time in Asia/Colombo (UTC+5:30)
    const options: Intl.DateTimeFormatOptions = {
      timeZone: "Asia/Colombo",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    };
    const timeStr = new Intl.DateTimeFormat("en-GB", options).format(now);
    el.textContent = `${timeStr} UTC+5:30`;
  };

  updateColomboClock();
  setInterval(updateColomboClock, 1000);

  // Mobile Drawer Toggle
  const menuBtn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const line1 = document.getElementById("burger-line-1");
  const line2 = document.getElementById("burger-line-2");
  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    if (drawer && line1 && line2) {
      if (isOpen) {
        drawer.classList.remove(
          "opacity-0",
          "translate-y-[-10px]",
          "pointer-events-none",
        );
        drawer.classList.add("opacity-100", "translate-y-0");
        line1.style.transform = "translateY(3.5px) rotate(45deg)";
        line2.style.transform = "translateY(-3.5px) rotate(-45deg)";
      } else {
        drawer.classList.add(
          "opacity-0",
          "translate-y-[-10px]",
          "pointer-events-none",
        );
        drawer.classList.remove("opacity-100", "translate-y-0");
        line1.style.transform = "";
        line2.style.transform = "";
      }
    }
  };

  menuBtn?.addEventListener("click", toggleMenu);
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
