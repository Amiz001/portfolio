---
import { siteMeta } from "../data/portfolio";
---

<footer
  class="relative w-full bg-[#03060c] border-t border-white/10 pt-16 pb-12 px-4 sm:px-8 md:px-12 lg:px-16 overflow-hidden"
>
  <div class="max-w-7xl mx-auto flex flex-col justify-between gap-12">
    <!-- Bottom Credits & Legal -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#8e9fb5] text-center sm:text-left"
    >
      <p>
        © {new Date().getFullYear()}
        {siteMeta.fullName}. All rights reserved.
      </p>
      <p class="flex items-center gap-2">
        <span>Architected with</span>
        <span class="text-[#60a5fa]">Astro 5</span>
        <span>&</span>
        <span class="text-[#93c5fd]">Tailwind CSS</span>
      </p>
      <p>{siteMeta.location}</p>
    </div>
  </div>
</footer>
