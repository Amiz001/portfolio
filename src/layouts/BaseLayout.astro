---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amila (Amiz) — Software Developer & Creative Engineer",
  description = "Portfolio of Amila Shan (Amiz) — Full-stack developer specializing in modern web architecture, kinetic interfaces, and performant web systems based in Colombo."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04070d" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/LOGO.webp" />

    <!-- Google Fonts: Plus Jakarta Sans + Space Grotesk + Syne -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#04070d] text-[#f4f8ff] antialiased selection:bg-[#60a5fa] selection:text-black">
    <div class="fixed inset-0 pointer-events-none z-50 bg-noise opacity-30"></div>
    <div class="fixed inset-0 pointer-events-none z-0 architectural-grid opacity-25"></div>

    <!-- Fluid Light-Wave Cursor Canvas (Desktop Only) -->
    <canvas id="cursor-light-trail" class="fixed inset-0 pointer-events-none z-50 hidden md:block"></canvas>

    <slot />

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Smooth inertia scrolling with Lenis
      const lenis = new Lenis({
        duration: 1.1,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
      });

      (window as any).lenis = lenis;

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      // Prevent lag jumps on tab switch / throttle
      gsap.ticker.lagSmoothing(500, 33);

      // Smooth anchor scrolling
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.startsWith('#') && href.length > 1) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              lenis.scrollTo(target as HTMLElement, { offset: -30 });
            }
          }
        });
      });

      // Back to top hook
      const backToTopBtn = document.getElementById('back-to-top-btn');
      backToTopBtn?.addEventListener('click', () => {
        lenis.scrollTo(0);
      });

      // Magnetic Pull Physics on Primary Action Targets
      const magneticElements = document.querySelectorAll('[data-magnetic]');
      magneticElements.forEach((elem) => {
        const el = elem as HTMLElement;
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          gsap.to(el, {
            x: x * 0.25,
            y: y * 0.25,
            duration: 0.3,
            ease: 'power2.out',
          });
        });

        el.addEventListener('mouseleave', () => {
          gsap.to(el, {
            x: 0,
            y: 0,
            duration: 0.7,
            ease: 'elastic.out(1, 0.4)',
          });
        });
      });

      // Fluid Light-Wave / Comet Trail Engine
      const canvas = document.getElementById('cursor-light-trail') as HTMLCanvasElement | null;
      if (canvas && window.matchMedia('(pointer: fine)').matches) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = (canvas.width = window.innerWidth);
          let height = (canvas.height = window.innerHeight);

          window.addEventListener('resize', () => {
            if (!canvas) return;
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
          });

          const TRAIL_LENGTH = 22;
          const trail: { x: number; y: number; vx: number; vy: number }[] = [];
          let mouse = { x: -100, y: -100, active: false };
          let prevMouse = { x: -100, y: -100 };
          let velocity = 0;

          for (let i = 0; i < TRAIL_LENGTH; i++) {
            trail.push({ x: -100, y: -100, vx: 0, vy: 0 });
          }

          window.addEventListener('mousemove', (e) => {
            if (!mouse.active) {
              mouse.active = true;
              for (let i = 0; i < TRAIL_LENGTH; i++) {
                trail[i].x = e.clientX;
                trail[i].y = e.clientY;
              }
            }
            prevMouse.x = mouse.x;
            prevMouse.y = mouse.y;
            mouse.x = e.clientX;
            mouse.y = e.clientY;

            const dx = mouse.x - prevMouse.x;
            const dy = mouse.y - prevMouse.y;
            velocity = Math.min(Math.sqrt(dx * dx + dy * dy), 40);
          });

          window.addEventListener('mouseleave', () => {
            mouse.active = false;
          });

          const render = () => {
            ctx.clearRect(0, 0, width, height);

            if (mouse.active && trail[0].x > -50) {
              // Smooth spring follow for trail nodes
              trail[0].x += (mouse.x - trail[0].x) * 0.75;
              trail[0].y += (mouse.y - trail[0].y) * 0.75;

              for (let i = 1; i < TRAIL_LENGTH; i++) {
                const prev = trail[i - 1];
                const current = trail[i];
                // Smooth easing with slight tension
                current.x += (prev.x - current.x) * 0.48;
                current.y += (prev.y - current.y) * 0.48;
              }

              // Draw Glowing Light-Wave Ribbon
              ctx.save();
              ctx.lineCap = 'round';
              ctx.lineJoin = 'round';

              for (let i = 0; i < TRAIL_LENGTH - 1; i++) {
                const ratio = 1 - i / TRAIL_LENGTH; // 1 at head, 0 at tail
                const p1 = trail[i];
                const p2 = trail[i + 1];

                const midX = (p1.x + p2.x) / 2;
                const midY = (p1.y + p2.y) / 2;

                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.quadraticCurveTo(p1.x, p1.y, midX, midY);

                // Luminous Glacial Sapphire Gradient
                const alpha = Math.max(0, ratio * 0.85);
                const width = Math.max(1, ratio * (velocity > 5 ? 7.5 : 4.5));

                ctx.lineWidth = width;
                ctx.strokeStyle = `rgba(96, 165, 250, ${alpha})`;
                ctx.shadowBlur = ratio > 0.4 ? 14 : 6;
                ctx.shadowColor = 'rgba(96, 165, 250, 0.9)';
                ctx.stroke();

                // Bright Core Sparkle at the head
                if (i < 3) {
                  ctx.lineWidth = width * 0.4;
                  ctx.strokeStyle = `rgba(240, 249, 255, ${ratio * 0.95})`;
                  ctx.shadowBlur = 18;
                  ctx.shadowColor = 'rgba(255, 255, 255, 1)';
                  ctx.stroke();
                }
              }

              // Head Star Halo
              ctx.beginPath();
              ctx.arc(trail[0].x, trail[0].y, 2.2, 0, Math.PI * 2);
              ctx.fillStyle = '#ffffff';
              ctx.shadowBlur = 12;
              ctx.shadowColor = '#93c5fd';
              ctx.fill();

              ctx.restore();
            }

            requestAnimationFrame(render);
          };

          render();
        }
      }
    </script>
  </body>
</html>

